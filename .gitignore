# 忽略Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 结果文件
result/

# 公共配置、schema 和加载代码需要跟随仓库发布。
# 只忽略开发者本地覆盖和私密配置。
uav_agent/configs/local.yaml
uav_agent/configs/private/

# 仓库根目录的模型权重不入 Git；uav_agent/models/ 是需要跟踪的客户端代码。
/models/
/.venvs/
*.safetensors
checkpoint-*

uav_agent/logs/

# Generated experiment results, checkpoints, CSV metrics and TensorBoard data.
/outputs/
*.tfevents.*

# Unreviewed optional Planner paraphrases are local candidates.  The official
# datasets/planner_v1 JSONL, manifest, statistics and checksums are not ignored.
# 本地数据集，不上传 GitHub
/datasets/
/uav_agent/datasets/
# Target-state schema/sequence code is source, not captured training data.
!/uav_agent/datasets/
/uav_agent/datasets/*
!/uav_agent/datasets/__init__.py
!/uav_agent/datasets/target_state/
/uav_agent/datasets/target_state/*
!/uav_agent/datasets/target_state/*.py
# 不上传任何目录下的 README 文件
**/README*
**/readme*
